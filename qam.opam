# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "An OCaml implementation of the Quantum Abstract Machine (QAM)"
description: """
A toolchain for the Quantum Abstract Machine of Li, Chang, Cleaveland, Zhu
and Wu (arXiv:2402.13469): a parser and reduction interpreter for QAM
membranes/processes, a normalize-then-canonicalize equivalence checker, a
compiler from QAM configurations to flat OpenQASM 2.0, and a built-in
statevector simulator used to verify compiled protocols (quantum
teleportation, bit-commitment, superdense coding) end-to-end."""
maintainer: ["Son Vu <vuleson59@gmail.com>"]
authors: ["Son Vu"]
license: "MIT"
homepage: "https://github.com/sonvule59/QAM-OCAML"
bug-reports: "https://github.com/sonvule59/QAM-OCAML/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.4"}
  "menhir" {>= "20211012"}
  "ounit2" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/sonvule59/QAM-OCAML.git"
